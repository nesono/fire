# Bazel configuration for Fire

# Use Bzlmod for dependency management
common --enable_bzlmod

# Python configuration
build --incompatible_default_to_explicit_init_py

# Test output
test --test_output=errors

# C++ configuration
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Java configuration - use Java 17 for records support
build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17

# Ty type checking (opt-in for development)
# Usage: bazel build --config=typecheck //...
build:typecheck --aspects //tools/lint:linters.bzl%ty
build:typecheck --output_groups=+rules_lint_report
