"""
Integration Test for Fire Requirements Management System

This workspace consumes fire as an external Bazel module to test
end-to-end integration as users would experience it.
"""

module(
    name = "fire_integration_test",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

bazel_dep(name = "fire", version = "0.6.0")
local_path_override(
    module_name = "fire",
    path = "..",
)

PYTHON_VERSION = "{{PYTHON_VERSION}}"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = PYTHON_VERSION)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")
