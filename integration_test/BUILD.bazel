"""Integration test for fire requirements management system."""

load("@fire//fire/starlark:codegen.bzl", "generate_cc_parameters", "generate_rust_parameters")
load("@fire//fire/starlark:parameters.bzl", "parameter_library")
load("@fire//fire/starlark:reports.bzl", "generate_report")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["test_params.yaml"])

# Validate and create parameter library
# Validates test_params.yaml and makes it available for code generation
parameter_library(
    name = "test_params",
    src = "test_params.yaml",
)

# Generate C++ headers from parameters (directory: test_params_cc/)
generate_cc_parameters(
    name = "test_params_h",
    base_name = "test_params_cc",
    parameter_library = ":test_params",
)

# Wrap generated headers in cc_library
cc_library(
    name = "test_params_cc",
    hdrs = [":test_params_h"],
    visibility = ["//visibility:public"],
)

# Generate Rust modules from parameters (directory: test_params_rs/)
generate_rust_parameters(
    name = "test_params_rs",
    base_name = "test_params_rs",
    parameter_library = ":test_params",
)

# Generate compliance report
generate_report(
    name = "compliance_report",
    srcs = ["//requirements:integration_requirements"],
    out = "compliance_report.md",
    report_type = "compliance",
)

# Generate coverage report
generate_report(
    name = "coverage_report",
    srcs = ["//requirements:integration_requirements"],
    out = "coverage_report.md",
    report_type = "coverage",
)

# Generate traceability report
generate_report(
    name = "traceability_report",
    srcs = ["//requirements:integration_requirements"],
    out = "traceability_report.md",
    report_type = "traceability",
)

# Dummy test targets referenced in requirements
sh_test(
    name = "test_speed_limit",
    srcs = ["test_dummy.sh"],
)

sh_test(
    name = "test_braking",
    srcs = ["test_dummy.sh"],
)

sh_test(
    name = "test_update_rate",
    srcs = ["test_dummy.sh"],
)
