load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "document_parser",
    srcs = ["document_parser.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//fire/starlark:markdown_common",
        "//fire/starlark:metadata_parsing",
        "//fire/starlark:path_common",
        "//fire/starlark:patterns",
    ],
)

py_library(
    name = "diagnostics",
    srcs = ["diagnostics.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":document_parser",
        "//fire/starlark:patterns",
    ],
)

py_test(
    name = "diagnostics_test",
    size = "small",
    srcs = ["diagnostics_test.py"],
    deps = [
        ":diagnostics",
        ":document_parser",
        "@pip//pytest",
    ],
)

py_test(
    name = "document_parser_test",
    size = "small",
    srcs = ["document_parser_test.py"],
    deps = [
        ":document_parser",
        "@pip//pytest",
    ],
)
