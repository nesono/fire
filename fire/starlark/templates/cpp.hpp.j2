#pragma once

#include <array>     // for std::array
#include <cstddef>  // for size_t
#include <cstdint>  // for int32_t, int64_t, uint32_t, uint64_t
{% if not item.is_latest %}

#pragma message("WARNING: Parameter {{ item.base_name }} v{{ item.version }} is deprecated. Use v{{ item.max_version }} instead.")
{% endif %}

{% if namespace %}
namespace {{ namespace }} {

{% endif %}
{% if item.type == "table" %}
{% set struct_name = item.base_name | pascal_case + "Row" %}
struct {{ struct_name }} {
{% for col in item.columns %}
{% if col.unit_suffix %}
{% set field_name = col.name + "_" + col.unit_suffix %}
{% else %}
{% set field_name = col.name %}
{% endif %}
    {{ col.type | cpp_type }} {{ field_name }};  ///< Unit: {{ col.unit }}

{% endfor %}
};

{% set size = item.rows | length %}
{% if item.unit_suffix %}
{% set const_name = (item.base_name + "_" + item.unit_suffix) | upper %}
{% else %}
{% set const_name = item.base_name | upper %}
{% endif %}
/// {{ item.description | default("") }}
constexpr std::array<{{ struct_name }}, {{ size }}> {{ const_name }} = {{ "{" }}{
{% for row in item.rows %}
    {{ "{" }}{% for i in range(item.columns | length) %}{% if item.columns[i].type == "string" %}"{{ row[i] }}"{% elif item.columns[i].type == "bool" %}{% if row[i] %}true{% else %}false{% endif %}{% else %}{{ row[i] }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{{ "}" }},
{% endfor %}
}};

constexpr const std::array<{{ struct_name }}, {{ size }}>& {{ item.base_name }}() {
    return {{ const_name }};
}

{% else %}
{% set cpp_type = item.type | cpp_type %}
{% if item.unit_suffix %}
{% set const_name = (item.base_name + "_" + item.unit_suffix) | upper %}
{% else %}
{% set const_name = item.base_name | upper %}
{% endif %}
/// {{ item.description | default("") }} - Unit: {{ item.unit }}
constexpr {{ cpp_type }} {{ const_name }} = {% if item.type == "string" %}"{{ item.value }}"{% elif item.type == "bool" %}{% if item.value %}true{% else %}false{% endif %}{% else %}{{ item.value }}{% endif %};

{% endif %}
{% if namespace %}
}  // namespace {{ namespace }}
{% endif %}
