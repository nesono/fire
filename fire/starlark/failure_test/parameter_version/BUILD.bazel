"""Tests for parameter version checking.

These tests verify that version mismatch detection works correctly:
- Version too old (expected > actual): file doesn't exist -> build/import error
- Version upgraded (expected < actual): file exists with deprecation warning

They are tagged as 'manual' and 'failure_test' so they don't run in normal test runs.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//fire/starlark:codegen.bzl", "generate_cc_parameters", "generate_go_parameters", "generate_java_parameters", "generate_python_parameters", "generate_rust_parameters")
load("//fire/starlark:parameters.bzl", "parameter_library")

# Generate parameter library from test YAML
parameter_library(
    name = "test_params",
    srcs = "test_params.yaml",
)

# Generate C++ code (directory of per-param-version .h files)
generate_cc_parameters(
    name = "test_params_h",
    base_name = "test_params_cc",
    namespace = "test",
    parameter_library = ":test_params",
)

cc_library(
    name = "test_params_cc",
    hdrs = [":test_params_h"],
)

# Generate Python code (directory of per-param-version .py files)
generate_python_parameters(
    name = "test_params_py_src",
    base_name = "test_params_py",
    parameter_library = ":test_params",
)

py_library(
    name = "test_params_py",
    data = [":test_params_py_src"],
)

# Generate Go code (directory of sub-packages)
generate_go_parameters(
    name = "test_params_go_src",
    base_name = "test_params_go",
    parameter_library = ":test_params",
)

go_library(
    name = "test_params_go_lib",
    srcs = [":test_params_go_src"],
    importpath = "fire/starlark/failure_test/parameter_version/test_params_go",
)

# Generate Rust code (directory of per-param-version .rs files)
generate_rust_parameters(
    name = "test_params_rust",
    base_name = "test_params_rs",
    parameter_library = ":test_params",
)

# Generate Java code (directory of per-param-version .java files)
generate_java_parameters(
    name = "test_params_java_src",
    package_prefix = "fire.starlark.failure_test.parameter_version",
    parameter_library = ":test_params",
)

java_library(
    name = "test_params_java",
    srcs = [":test_params_java_src"],
)

# =============================================================================
# Version Too Old Tests (expected > actual) - Should FAIL
# File test_value_v3.{ext} does not exist -> build/import error
# =============================================================================

# C++ - should fail to compile: file not found
cc_binary(
    name = "test_version_too_old_cpp",
    srcs = ["test_version_too_old_cpp.cc"],
    tags = [
        "failure_test",
        "manual",
        "version_too_old",
    ],
    deps = [":test_params_cc"],
)

# Python - should fail at import time: module not found
py_binary(
    name = "test_version_too_old_py",
    srcs = ["test_version_too_old_py.py"],
    tags = [
        "failure_test",
        "manual",
        "version_too_old",
    ],
    deps = [":test_params_py"],
)

# Go - should fail to compile: package not found
go_binary(
    name = "test_version_too_old_go",
    srcs = ["test_version_too_old_go.go"],
    tags = [
        "failure_test",
        "manual",
        "version_too_old",
    ],
    deps = [":test_params_go_lib"],
)

# Rust - should fail to compile: file not found
rust_binary(
    name = "test_version_too_old_rust",
    srcs = [
        "test_version_too_old_rust.rs",
        ":test_params_rust",
    ],
    edition = "2021",
    tags = [
        "failure_test",
        "manual",
        "version_too_old",
    ],
)

# Java - should fail to compile: class not found
java_binary(
    name = "test_version_too_old_java",
    srcs = ["TestVersionTooOld.java"],
    main_class = "fire.starlark.failure_test.parameter_version.TestVersionTooOld",
    tags = [
        "failure_test",
        "manual",
        "version_too_old",
    ],
    deps = [":test_params_java"],
)

# =============================================================================
# Version Upgraded Tests (expected < actual) - Should WARN
# File test_value_v1.{ext} exists with deprecation warning
# =============================================================================

# C++ - should emit deprecation warning at compile time
cc_binary(
    name = "test_version_upgraded_cpp",
    srcs = ["test_version_upgraded_cpp.cc"],
    tags = [
        "failure_test",
        "manual",
        "version_upgraded",
    ],
    deps = [":test_params_cc"],
)

# Rust - should emit deprecation warning at compile time
rust_binary(
    name = "test_version_upgraded_rust",
    srcs = [
        "test_version_upgraded_rust.rs",
        ":test_params_rust",
    ],
    edition = "2021",
    tags = [
        "failure_test",
        "manual",
        "version_upgraded",
    ],
)

# Python - should emit DeprecationWarning
py_binary(
    name = "test_version_upgraded_py",
    srcs = ["test_version_upgraded_py.py"],
    tags = [
        "failure_test",
        "manual",
        "version_upgraded",
    ],
    deps = [":test_params_py"],
)

# Go - should have Deprecated doc comment
go_binary(
    name = "test_version_upgraded_go",
    srcs = ["test_version_upgraded_go.go"],
    tags = [
        "failure_test",
        "manual",
        "version_upgraded",
    ],
    deps = [":test_params_go_lib"],
)

# Java - should have @Deprecated annotation
java_binary(
    name = "test_version_upgraded_java",
    srcs = ["TestVersionUpgraded.java"],
    javacopts = ["-Xlint:deprecation"],
    main_class = "fire.starlark.failure_test.parameter_version.TestVersionUpgraded",
    tags = [
        "failure_test",
        "manual",
        "version_upgraded",
    ],
    deps = [":test_params_java"],
)
