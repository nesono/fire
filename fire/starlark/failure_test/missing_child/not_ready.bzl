"""Release readiness gate that is expected to fail.

The failure test runner only discovers targets generated by macros, so the
rule is wrapped.
"""

load("//fire/starlark:reports.bzl", "release_readiness_test")

def release_not_ready_test(name, report):
    release_readiness_test(
        name = name,
        report = report,
        tags = [
            "failure_test",
            "manual",
            "release_not_ready",
        ],
    )
