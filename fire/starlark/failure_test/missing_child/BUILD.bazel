"""Tests for requirements that lack the coverage their document type requires.

These tests verify that the release readiness gate fails when a system
requirement has no child requirement.
They are tagged as 'manual' and 'failure_test' so they don't run in normal test runs.
"""

load("//fire/starlark:reports.bzl", "release_readiness_test", "release_report")
load("//fire/starlark:requirements.bzl", "requirement_library")
load("//fire/starlark/failure_test:macros.bzl", "discoverable")

requirement_library(
    name = "orphan_requirements",
    srcs = ["orphan.sysreq.md"],
)

release_report(
    name = "orphan_report",
    out = "ORPHAN_REPORT.md",
    product = "Missing child",
    requirements = [":orphan_requirements"],
)

# System requirement without a child requirement - should FAIL
discoverable(
    name = "test_missing_child",
    report = ":orphan_report",
    rule = release_readiness_test,
    tags = [
        "failure_test",
        "manual",
        "release_not_ready",
    ],
)
