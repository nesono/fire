load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":validator_test.bzl", "validator_test_suite")

exports_files([
    "validator.bzl",
    "parameters.bzl",
    "requirements.bzl",
    "reports.bzl",
    "generate_report.py",
    "generate_code.py",
    "validate_cross_references.py",
    "parameter_schema.json",
])

py_binary(
    name = "generate_code_script",
    srcs = [
        "generate_code.py",
        "generators/base.py",
        "generators/cpp.py",
        "generators/go.py",
        "generators/java.py",
        "generators/python.py",
        "generators/rust.py",
    ],
    main = "generate_code.py",
    visibility = ["//visibility:public"],
    deps = ["@pip//pyyaml"],
)

py_binary(
    name = "validate_parameters_script",
    srcs = [
        "parameter_models.py",
        "validate_parameters.py",
    ],
    main = "validate_parameters.py",
    visibility = ["//visibility:public"],
    deps = [
        "@pip//pydantic",
        "@pip//pyyaml",
    ],
)

py_binary(
    name = "validate_cross_references_script",
    srcs = ["validate_cross_references.py"],
    main = "validate_cross_references.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "generate_report_script",
    srcs = ["generate_report.py"],
    main = "generate_report.py",
    visibility = ["//visibility:public"],
)

validator_test_suite(name = "validator_test")

py_test(
    name = "validate_parameters_test",
    srcs = [
        "parameter_models.py",
        "validate_parameters.py",
        "validate_parameters_test.py",
    ],
    data = ["parameter_schema.json"],
    deps = [
        "@pip//pydantic",
        "@pip//pyyaml",
    ],
)
