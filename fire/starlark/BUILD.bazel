load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":validator_test.bzl", "validator_test_suite")

exports_files([
    "validator.bzl",
    "parameters.bzl",
    "requirements.bzl",
    "reports.bzl",
    "generate_report.py",
    "generate_code.py",
    "validate_cross_references.py",
    "parameter_schema.json",
])

# Python script for generating code from YAML
py_binary(
    name = "generate_code_script",
    srcs = [
        "generate_code.py",
        "generators/base.py",
        "generators/cpp.py",
        "generators/go.py",
        "generators/java.py",
        "generators/python.py",
        "generators/rust.py",
    ],
    main = "generate_code.py",
    visibility = ["//visibility:public"],
    deps = ["@pip//pyyaml"],
)

# Python script for validating parameter YAML files
py_binary(
    name = "validate_parameters_script",
    srcs = ["validate_parameters.py"],
    main = "validate_parameters.py",
    visibility = ["//visibility:public"],
    deps = [
        "@pip//jsonschema",
        "@pip//pyyaml",
    ],
)

# Python script for validating cross-references in requirements
py_binary(
    name = "validate_cross_references_script",
    srcs = ["validate_cross_references.py"],
    main = "validate_cross_references.py",
    visibility = ["//visibility:public"],
)

# Python script for generating reports
py_binary(
    name = "generate_report_script",
    srcs = ["generate_report.py"],
    main = "generate_report.py",
    visibility = ["//visibility:public"],
)

# Unit tests for validator
validator_test_suite(name = "validator_test")

# Python unit tests for parameter validation
py_test(
    name = "test_validate_parameters",
    srcs = [
        "test_validate_parameters.py",
        "validate_parameters.py",
    ],
    data = ["parameter_schema.json"],
    deps = [
        "@pip//jsonschema",
        "@pip//pyyaml",
    ],
)
