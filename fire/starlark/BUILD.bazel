load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    "parameters.bzl",
    "requirements.bzl",
    "reports.bzl",
    "generate_report.py",
    "generate_code.py",
    "validate_cross_references.py",
])

py_binary(
    name = "generate_code_script",
    srcs = [
        "generate_code.py",
        "generators/cpp.py",
        "generators/go.py",
        "generators/java.py",
        "generators/python.py",
        "generators/rust.py",
        "generators/template_loader.py",
    ],
    data = glob(["templates/*.j2"]),
    main = "generate_code.py",
    visibility = ["//visibility:public"],
    deps = [
        "@pip//jinja2",
        "@pip//pyyaml",
    ],
)

