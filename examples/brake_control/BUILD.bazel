load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//fire/starlark:requirements.bzl", "requirement_library")
load("//fire/starlark:traceability.bzl", "source_traceability")

exports_files(glob(["doc/*.swreq.md"]))

# Validate brake controller software requirements
requirement_library(
    name = "brake_controller_requirements",
    srcs = glob(["doc/*.swreq.md"]),
    visibility = ["//examples:__pkg__"],
    deps = ["//examples:vehicle_requirements"],
)

cc_library(
    name = "brake_controller",
    srcs = ["brake_controller.cc"],
    hdrs = ["brake_controller.h"],
)

cc_test(
    name = "brake_controller_test",
    srcs = ["brake_controller_test.cc"],
    deps = [":brake_controller"],
)

# Trace implementation sources to their requirements
source_traceability(
    name = "brake_controller_impl_trace",
    srcs = [
        "brake_controller.cc",
        "brake_controller.h",
    ],
    deps = [":brake_controller_requirements"],
)

# Trace test sources to their requirements
source_traceability(
    name = "brake_controller_test_trace",
    srcs = ["brake_controller_test.cc"],
    deps = [":brake_controller_requirements"],
)
