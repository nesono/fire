load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//fire/starlark:codegen.bzl", "generate_cc_parameters", "generate_go_parameters", "generate_java_parameters", "generate_python_parameters", "generate_rust_parameters")
load("//fire/starlark:parameters.bzl", "parameter_library")
load("//fire/starlark:reports.bzl", "generate_report")
load("//fire/starlark:requirements.bzl", "requirement_library")

# Validate and create parameter library from YAML file
parameter_library(
    name = "vehicle_params",
    src = "vehicle_params.yaml",
)

# Generate C++ headers (directory: vehicle_params_cc/)
generate_cc_parameters(
    name = "vehicle_params_h",
    base_name = "vehicle_params_cc",
    parameter_library = ":vehicle_params",
)

cc_library(
    name = "vehicle_params_cc",
    hdrs = [":vehicle_params_h"],
)

# C++ headers with custom namespace (directory: vehicle_params_custom_ns/)
generate_cc_parameters(
    name = "vehicle_params_custom_ns_h",
    base_name = "vehicle_params_custom_ns",
    namespace = "my_project::vehicle::params",
    parameter_library = ":vehicle_params",
)

cc_library(
    name = "vehicle_params_cc_custom_ns",
    hdrs = [":vehicle_params_custom_ns_h"],
)

# Generate Python modules (directory: vehicle_params_py/)
generate_python_parameters(
    name = "vehicle_params_py_src",
    base_name = "vehicle_params_py",
    parameter_library = ":vehicle_params",
)

py_library(
    name = "vehicle_params_py",
    data = [":vehicle_params_py_src"],
)

# Second Python library (directory: vehicle_params_py_alt/)
generate_python_parameters(
    name = "vehicle_params_py_alt_src",
    base_name = "vehicle_params_py_alt",
    parameter_library = ":vehicle_params",
)

py_library(
    name = "vehicle_params_py_alt",
    data = [":vehicle_params_py_alt_src"],
)

# Generate Java classes (directory: vehicle_params_java/)
generate_java_parameters(
    name = "vehicle_params_java_src",
    package_prefix = "com.example",
    parameter_library = ":vehicle_params",
)

java_library(
    name = "vehicle_params_java",
    srcs = [":vehicle_params_java_src"],
)

# Generate Go source (directory: vehicle_params_go/)
generate_go_parameters(
    name = "vehicle_params_go_src",
    base_name = "vehicle_params_go",
    parameter_library = ":vehicle_params",
)

# Go library wrapping all generated parameter files (single package)
go_library(
    name = "vehicle_params_go",
    srcs = [":vehicle_params_go_src"],
)

# Second Go library set (directory: vehicle_params_go_alt/)
generate_go_parameters(
    name = "vehicle_params_go_alt_src",
    base_name = "vehicle_params_go_alt",
    parameter_library = ":vehicle_params",
)

go_library(
    name = "vehicle_params_go_alt",
    srcs = [":vehicle_params_go_alt_src"],
)

# Generate Rust modules (directory: vehicle_params_rs/)
generate_rust_parameters(
    name = "vehicle_params_rs",
    base_name = "vehicle_params_rs",
    parameter_library = ":vehicle_params",
)

# Second Rust module (directory: vehicle_params_rs_alt/)
generate_rust_parameters(
    name = "vehicle_params_rs_alt",
    base_name = "vehicle_params_rs_alt",
    parameter_library = ":vehicle_params",
)

# C++ tests
cc_test(
    name = "vehicle_params_cc_test",
    srcs = ["vehicle_params_test.cc"],
    deps = [":vehicle_params_cc"],
)

cc_test(
    name = "vehicle_params_cc_custom_ns_test",
    srcs = ["vehicle_params_custom_ns_test.cc"],
    deps = [":vehicle_params_cc_custom_ns"],
)

# Python tests
py_test(
    name = "vehicle_params_py_test",
    srcs = ["vehicle_params_test.py"],
    main = "vehicle_params_test.py",
    deps = [":vehicle_params_py"],
)

py_test(
    name = "vehicle_params_py_alt_test",
    srcs = ["vehicle_params_alt_test.py"],
    main = "vehicle_params_alt_test.py",
    deps = [":vehicle_params_py_alt"],
)

# Java test
java_test(
    name = "vehicle_params_java_test",
    srcs = ["VehicleParamsTest.java"],
    test_class = "com.example.VehicleParamsTest",
    deps = [":vehicle_params_java"],
)

# Go tests
go_test(
    name = "vehicle_params_go_test",
    srcs = ["vehicle_params_test.go"],
    deps = [":vehicle_params_go"],
)

go_test(
    name = "vehicle_params_go_alt_test",
    srcs = ["vehicle_params_alt_test.go"],
    deps = [":vehicle_params_go_alt"],
)

# Rust tests
rust_test(
    name = "vehicle_params_rust_test",
    srcs = [
        "vehicle_params_test.rs",
        ":vehicle_params_rs",
    ],
    crate_root = "vehicle_params_test.rs",
    edition = "2021",
)

rust_test(
    name = "vehicle_params_rust_alt_test",
    srcs = [
        "vehicle_params_alt_test.rs",
        ":vehicle_params_rs_alt",
    ],
    crate_root = "vehicle_params_alt_test.rs",
    edition = "2021",
)

# Validate requirement documents
requirement_library(
    name = "vehicle_requirements",
    srcs = glob(["requirements/*.md"]),
    deps = [":vehicle_params"],
)

requirement_library(
    name = "component_requirements",
    srcs = glob([
        "brake_actuator/doc/*.swreq.md",
        "brake_control/doc/*.swreq.md",
        "vehicle_status/doc/*.swreq.md",
    ]),
    deps = [
        ":vehicle_params",
        ":vehicle_requirements",
    ],
)

# Reports
generate_report(
    name = "traceability_matrix",
    srcs = glob(["requirements/*.md"]),
    out = "TRACEABILITY_MATRIX.md",
    report_type = "traceability",
)

generate_report(
    name = "coverage_report",
    srcs = glob(["requirements/*.md"]),
    out = "COVERAGE_REPORT.md",
    report_type = "coverage",
)

generate_report(
    name = "change_impact_report",
    srcs = glob(["requirements/*.md"]),
    out = "CHANGE_IMPACT.md",
    report_type = "change_impact",
)

generate_report(
    name = "compliance_report",
    srcs = glob(["requirements/*.md"]),
    out = "COMPLIANCE_ISO26262.md",
    critical_type = "safety",
    report_type = "compliance",
    standard = "ISO 26262",
)
