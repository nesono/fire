load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_go//go:def.bzl", "go_test")
load("@rules_java//java:defs.bzl", "java_test")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_test")
load(
    "//fire/starlark:parameters.bzl",
    "cc_parameter_library",
    "go_parameter_library",
    "java_parameter_library",
    "parameter_library",
    "python_parameter_library",
    "rust_parameter_library",
)
load("//fire/starlark:reports.bzl", "generate_report")
load("//fire/starlark:requirements.bzl", "requirement_library")
load(":vehicle_params.bzl", "VEHICLE_PARAMS")

# Export parameter source file for dependency tracking
filegroup(
    name = "vehicle_params_bzl",
    srcs = ["vehicle_params.bzl"],
)

# Validate and create parameter library (loaded from separate .bzl file for better organization)
# Namespace is auto-derived from package path: examples -> examples
# Creates vehicle_params.json containing validated parameter data
parameter_library(
    name = "vehicle_params",
    parameters = VEHICLE_PARAMS,
)

# Generate C++ library with parameters
# Consumes vehicle_params.json and generates vehicle_params.h
cc_parameter_library(
    name = "vehicle_params_cc",
    parameter_library = ":vehicle_params",
)

# Generate Python library with parameters
# Consumes vehicle_params.json and generates vehicle_params.py
python_parameter_library(
    name = "vehicle_params_py",
    parameter_library = ":vehicle_params",
)

# Generate Java parameters
# Consumes vehicle_params.json and generates VehicleParams.java
java_parameter_library(
    name = "vehicle_params_java",
    class_name = "VehicleParams",
    package_prefix = "com.example",  # Results in: com.example.examples
    parameter_library = ":vehicle_params",
)

# Generate Go library with parameters
# Consumes vehicle_params.json and generates vehicle_params.go
go_parameter_library(
    name = "vehicle_params_go",
    parameter_library = ":vehicle_params",
)

# Generate Rust parameters
# Consumes vehicle_params.json and generates vehicle_params.rs
rust_parameter_library(
    name = "vehicle_params_rs",
    parameter_library = ":vehicle_params",
)

# C++ test that uses the generated parameters
cc_test(
    name = "vehicle_params_cc_test",
    srcs = ["vehicle_params_test.cc"],
    deps = [":vehicle_params_cc"],
)

# Python test that uses the generated parameters
py_test(
    name = "vehicle_params_py_test",
    srcs = ["vehicle_params_test.py"],
    main = "vehicle_params_test.py",
    deps = [":vehicle_params_py"],
)

# Java test that uses the generated parameters
java_test(
    name = "vehicle_params_java_test",
    srcs = ["VehicleParamsTest.java"],
    test_class = "com.example.examples.VehicleParamsTest",
    deps = [":vehicle_params_java"],
)

# Go test that uses the generated parameters
go_test(
    name = "vehicle_params_go_test",
    srcs = ["vehicle_params_test.go"],
    deps = [":vehicle_params_go"],
)

# Rust test that uses the generated parameters
rust_test(
    name = "vehicle_params_rust_test",
    srcs = [
        "vehicle_params_test.rs",
        ":vehicle_params_rs",
    ],
    crate_root = "vehicle_params_test.rs",
    edition = "2021",
)

# Validate requirement documents (system requirements)
requirement_library(
    name = "vehicle_requirements",
    srcs = glob(["requirements/*.md"]),
    deps = [":vehicle_params_bzl"],  # System requirements reference parameter files
)

# Validate software component requirement documents
requirement_library(
    name = "component_requirements",
    srcs = glob([
        "brake_actuator/doc/*.swreq.md",
        "brake_control/doc/*.swreq.md",
        "vehicle_status/doc/*.swreq.md",
    ]),
    deps = [
        ":vehicle_params_bzl",  # Component requirements also reference parameter files
        ":vehicle_requirements",  # Component requirements reference system requirements
    ],
)

# Generate traceability matrix report
generate_report(
    name = "traceability_matrix",
    srcs = glob(["requirements/*.md"]),
    out = "TRACEABILITY_MATRIX.md",
    report_type = "traceability",
)

# Generate coverage report
generate_report(
    name = "coverage_report",
    srcs = glob(["requirements/*.md"]),
    out = "COVERAGE_REPORT.md",
    report_type = "coverage",
)

# Generate change impact analysis
generate_report(
    name = "change_impact_report",
    srcs = glob(["requirements/*.md"]),
    out = "CHANGE_IMPACT.md",
    report_type = "change_impact",
)

# Generate ISO 26262 compliance report
generate_report(
    name = "compliance_report",
    srcs = glob(["requirements/*.md"]),
    out = "COMPLIANCE_ISO26262.md",
    critical_type = "safety",  # Highlight safety requirements
    report_type = "compliance",
    standard = "ISO 26262",
)
